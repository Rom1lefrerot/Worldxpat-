/* ============================================
   VARIABLES & RESET
   ============================================ */

:root {
  /* Couleurs principales */
  --color-primary: #2563eb;
  --color-primary-dark: #1d4ed8;
  --color-primary-light: #3b82f6;
  
  /* Couleurs secondaires (sable/beige) */
  --color-sand: #f6d5b0;
  --color-sand-light: #fae8d1;
  --color-sand-dark: #ec9455;
  
  /* Neutres */
  --color-white: #ffffff;
  --color-gray-50: #f9fafb;
  --color-gray-100: #f3f4f6;
  --color-gray-200: #e5e7eb;
  --color-gray-300: #d1d5db;
  --color-gray-400: #9ca3af;
  --color-gray-500: #6b7280;
  --color-gray-600: #4b5563;
  --color-gray-700: #374151;
  --color-gray-800: #1f2937;
  --color-gray-900: #111827;
  
  /* Typographie */
  --font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
    'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
  
  /* Espacements */
  --spacing-xs: 0.5rem;
  --spacing-sm: 1rem;
  --spacing-md: 1.5rem;
  --spacing-lg: 2rem;
  --spacing-xl: 3rem;
  --spacing-2xl: 4rem;
  --spacing-3xl: 6rem;
  
  /* Ombres */
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  
  /* Bordures */
  --radius-sm: 0.5rem;
  --radius-md: 0.75rem;
  --radius-lg: 1rem;
  --radius-xl: 1.5rem;
  --radius-2xl: 2rem;
  
  /* Transitions */
  --transition-fast: 150ms ease;
  --transition-base: 300ms ease;
  --transition-slow: 500ms ease;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  font-family: var(--font-family);
  color: var(--color-gray-900);
  background-color: var(--color-white);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ============================================
   UTILITAIRES
   ============================================ */

.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 var(--spacing-md);
}

@media (min-width: 768px) {
  .container {
    padding: 0 var(--spacing-lg);
  }
}

.text-primary {
  color: var(--color-primary);
}

.section {
  padding: var(--spacing-3xl) 0;
}

.section-alt {
  background-color: var(--color-gray-50);
}

.section-header {
  text-align: center;
  margin-bottom: var(--spacing-2xl);
  max-width: 700px;
  margin-left: auto;
  margin-right: auto;
}

.section-title {
  font-size: 2rem;
  font-weight: 700;
  color: var(--color-gray-900);
  margin-bottom: var(--spacing-sm);
  letter-spacing: -0.02em;
}

.section-subtitle {
  font-size: 1.125rem;
  color: var(--color-gray-600);
  line-height: 1.7;
}

@media (min-width: 768px) {
  .section-title {
    font-size: 2.5rem;
  }
  
  .section-subtitle {
    font-size: 1.25rem;
  }
}

/* ============================================
   HEADER / NAVBAR
   ============================================ */

.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background-color: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  transition: all var(--transition-base);
  border-bottom: 1px solid transparent;
}

.header.scrolled {
  background-color: rgba(255, 255, 255, 0.95);
  box-shadow: var(--shadow-sm);
  border-bottom-color: var(--color-gray-200);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md) var(--spacing-md);
  height: 70px;
}

@media (min-width: 768px) {
  .nav {
    padding: var(--spacing-md) var(--spacing-lg);
  }
}

.nav-logo a {
  font-size: 1.65rem;
  font-weight: 700;
  text-decoration: none;
  letter-spacing: -0.04em;
  background: linear-gradient(120deg, var(--color-gray-900), var(--color-primary));
  -webkit-background-clip: text;
  color: transparent;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  transition: transform var(--transition-fast);
  text-transform: uppercase;
}

.nav-logo a::after {
  content: '';
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: linear-gradient(120deg, var(--color-primary), var(--color-sand-dark));
  box-shadow: 0 0 12px rgba(37, 99, 235, 0.5);
}

.nav-logo a:hover {
  transform: translateY(-1px);
}

.nav-links {
  display: none;
  list-style: none;
  align-items: center;
  gap: var(--spacing-lg);
}

@media (min-width: 768px) {
  .nav-links {
    display: flex;
  }
}

.nav-link {
  color: var(--color-gray-700);
  text-decoration: none;
  font-size: 0.9375rem;
  font-weight: 500;
  transition: color var(--transition-fast);
  position: relative;
}

.nav-link:hover {
  color: var(--color-primary);
}

.nav-link.btn-nav-cta {
  background-color: var(--color-primary);
  color: var(--color-white);
  padding: var(--spacing-xs) var(--spacing-md);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast);
}

.nav-link.btn-nav-cta:hover {
  background-color: var(--color-primary-dark);
  color: var(--color-white);
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

.nav-toggle {
  display: flex;
  flex-direction: column;
  gap: 4px;
  background: none;
  border: none;
  cursor: pointer;
  padding: var(--spacing-xs);
}

@media (min-width: 768px) {
  .nav-toggle {
    display: none;
  }
}

.nav-toggle span {
  width: 24px;
  height: 2px;
  background-color: var(--color-gray-900);
  transition: all var(--transition-fast);
  border-radius: 2px;
}

.nav-toggle.active span:nth-child(1) {
  transform: rotate(45deg) translate(6px, 6px);
}

.nav-toggle.active span:nth-child(2) {
  opacity: 0;
}

.nav-toggle.active span:nth-child(3) {
  transform: rotate(-45deg) translate(6px, -6px);
}

/* Language Switcher */
.language-switcher {
  display: inline-flex;
  align-items: center;
  background-color: var(--color-gray-100);
  border-radius: var(--radius-lg);
  padding: 4px;
  gap: 0;
  position: relative;
  border: 1px solid var(--color-gray-200);
  transition: all var(--transition-fast);
}

.language-switcher:hover {
  border-color: var(--color-gray-300);
  box-shadow: var(--shadow-sm);
}

.language-option {
  position: relative;
  padding: 6px 16px;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-gray-600);
  background: transparent;
  border: none;
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all var(--transition-fast);
  font-family: inherit;
  z-index: 1;
  min-width: 44px;
  text-align: center;
}

.language-option:hover {
  color: var(--color-gray-900);
}

.language-option[aria-pressed="true"] {
  color: var(--color-white);
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  box-shadow: 
    0 2px 4px rgba(37, 99, 235, 0.2),
    0 1px 2px rgba(37, 99, 235, 0.1);
}

.language-option[aria-pressed="true"]:hover {
  background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
  transform: translateY(-1px);
  box-shadow: 
    0 4px 6px rgba(37, 99, 235, 0.25),
    0 2px 4px rgba(37, 99, 235, 0.15);
}

/* Mobile menu */
@media (max-width: 767px) {
  .nav-links.mobile-open {
    display: flex;
    flex-direction: column;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: var(--color-white);
    padding: var(--spacing-md);
    box-shadow: var(--shadow-lg);
    border-top: 1px solid var(--color-gray-200);
  }
  
  .nav-links.mobile-open .nav-link {
    padding: var(--spacing-sm) 0;
    width: 100%;
  }
}

/* ============================================
   HERO SECTION
   ============================================ */

.hero {
  position: relative;
  padding: calc(70px + var(--spacing-3xl)) 0 calc(var(--spacing-3xl) + var(--spacing-xl));
  min-height: calc(100vh - 70px);
  display: flex;
  align-items: center;
  overflow: hidden;
}

/* Hero Background - Dégradé radial + shapes floues */
.hero-background {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
}

.hero-gradient {
  position: absolute;
  top: -20%;
  left: -10%;
  width: 120%;
  height: 120%;
  background: radial-gradient(circle at 30% 50%, rgba(37, 99, 235, 0.08) 0%, rgba(255, 255, 255, 0) 60%);
  opacity: 1;
}

.hero-shape {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  opacity: 0.4;
  pointer-events: none;
}

.hero-shape-1 {
  width: 500px;
  height: 500px;
  background: var(--color-primary);
  top: -200px;
  right: -150px;
  animation: float 20s ease-in-out infinite;
}

.hero-shape-2 {
  width: 400px;
  height: 400px;
  background: var(--color-sand);
  bottom: -150px;
  left: -100px;
  animation: float 25s ease-in-out infinite reverse;
}

@keyframes float {
  0%, 100% {
    transform: translate(0, 0) scale(1);
  }
  50% {
    transform: translate(30px, -30px) scale(1.1);
  }
}

.hero-content {
  position: relative;
  z-index: 1;
  display: grid;
  gap: var(--spacing-2xl);
  align-items: start;
  width: 100%;
}

@media (min-width: 1024px) {
  .hero-content {
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-3xl);
    align-items: center;
  }
}

.hero-text {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xl);
  max-width: 520px;
}

.hero-text .hero-title,
.hero-text .hero-subtitle,
.hero-text .hero-cta {
  width: 100%;
}

.hero-text-wrapper {
  width: 100%;
}

.hero-text {
  margin: 0 auto;
}

@media (min-width: 1024px) {
  .hero-text {
    margin: 0;
  }
}

.hero-visual {
  position: relative;
  z-index: 1;
  display: flex;
  width: 100%;
  justify-content: center;
}

.hero-visual::before {
  content: '';
  position: absolute;
  top: -10%;
  right: 10%;
  width: 220px;
  height: 220px;
  background: radial-gradient(circle, rgba(250, 232, 209, 0.7), transparent 70%);
  filter: blur(20px);
  opacity: 0.6;
  pointer-events: none;
  z-index: -1;
}

@media (min-width: 1024px) {
  .hero-visual {
    justify-content: flex-end;
  }
}

.hero-cards {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xl);
  width: min(420px, 100%);
  margin: 0 auto;
}

@media (min-width: 640px) {
  .hero-cards {
    width: min(460px, 100%);
  }
}

.founder-card {
  width: min(360px, 100%);
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 32px;
  padding: var(--spacing-lg);
  box-shadow:
    0 25px 60px rgba(15, 23, 42, 0.15),
    0 10px 25px rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  position: relative;
  overflow: hidden;
}

.founder-card::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 32px;
  border: 1px solid rgba(37, 99, 235, 0.15);
  pointer-events: none;
}

.founder-image {
  width: min(260px, 100%);
  aspect-ratio: 1 / 1;
  padding: 6px;
  border-radius: 999px;
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.7), rgba(236, 148, 85, 0.7));
  margin: 0 auto;
  display: flex;
}

.founder-image img {
  width: 100%;
  height: 100%;
  border-radius: 999px;
  object-fit: cover;
  display: block;
  box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.12);
}

.founder-info {
  margin-top: var(--spacing-md);
}

.founder-label {
  font-size: 0.75rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--color-gray-500);
  margin-bottom: var(--spacing-xs);
}

.founder-name {
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--color-gray-900);
  margin-bottom: var(--spacing-xs);
}

.founder-quote {
  font-size: 0.9375rem;
  color: var(--color-gray-600);
  line-height: 1.6;
  font-style: italic;
}

.hero-title {
  font-size: 2.75rem;
  font-weight: 700;
  line-height: 1.15;
  color: var(--color-gray-900);
  letter-spacing: -0.04em;
  margin: 0;
}

@media (min-width: 768px) {
  .hero-title {
    font-size: 3.85rem;
  }
}

@media (min-width: 1024px) {
  .hero-title {
    font-size: 4.4rem;
  }
}

.hero-subtitle {
  font-size: 1.25rem;
  color: var(--color-gray-600);
  line-height: 1.8;
  margin: 0;
  max-width: 90%;
}

@media (min-width: 768px) {
  .hero-subtitle {
    font-size: 1.375rem;
    max-width: 100%;
  }
}

.hero-cta {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  margin-top: var(--spacing-sm);
}

@media (min-width: 640px) {
  .hero-cta {
    flex-direction: row;
    gap: var(--spacing-lg);
  }
}

/* Animations Hero */
.hero-animate-fade-up {
  opacity: 0;
  transform: translateY(30px);
  animation: fadeUp 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.hero-animate-slide-in {
  opacity: 0;
  transform: translateX(50px);
  animation: slideIn 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes fadeUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideIn {
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* Preview Card */
.hero-preview {
  position: relative;
}

.preview-card-wrapper {
  position: relative;
}

.preview-card-bg {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 110%;
  height: 110%;
  background: radial-gradient(circle, rgba(37, 99, 235, 0.15) 0%, transparent 70%);
  filter: blur(60px);
  z-index: 0;
  opacity: 0.6;
}

.preview-card {
  position: relative;
  z-index: 1;
  background: var(--color-white);
  border-radius: var(--radius-2xl);
  box-shadow: 
    0 20px 25px -5px rgba(0, 0, 0, 0.08),
    0 10px 10px -5px rgba(0, 0, 0, 0.04),
    0 0 0 1px rgba(0, 0, 0, 0.05);
  padding: var(--spacing-xl);
  border: 1px solid rgba(0, 0, 0, 0.06);
  transition: all 600ms cubic-bezier(0.16, 1, 0.3, 1);
  transform: translateY(0);
}

.preview-card:hover {
  transform: translateY(-8px);
  box-shadow: 
    0 32px 40px -8px rgba(0, 0, 0, 0.12),
    0 16px 20px -8px rgba(0, 0, 0, 0.08),
    0 0 0 1px rgba(0, 0, 0, 0.05);
}

.preview-header h3 {
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--color-gray-900);
  margin-bottom: var(--spacing-lg);
  letter-spacing: -0.01em;
}

.preview-groups {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.preview-group-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  padding: var(--spacing-md);
  border-radius: var(--radius-lg);
  transition: all var(--transition-base);
  background-color: transparent;
}

.preview-group-item:hover {
  background-color: var(--color-gray-50);
  transform: translateX(4px);
}

.preview-flag {
  font-size: 2rem;
  line-height: 1;
  flex-shrink: 0;
}

.preview-group-info {
  flex: 1;
  min-width: 0;
}

.preview-group-name {
  font-weight: 600;
  color: var(--color-gray-900);
  font-size: 1rem;
  margin-bottom: 6px;
  line-height: 1.3;
}

.preview-group-meta {
  display: flex;
  gap: var(--spacing-xs);
  flex-wrap: wrap;
  align-items: center;
}

.preview-badge {
  font-size: 0.8125rem;
  color: var(--color-gray-600);
  background-color: var(--color-gray-100);
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.preview-tag {
  font-size: 0.8125rem;
  color: var(--color-primary);
  background-color: rgba(37, 99, 235, 0.12);
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

/* ============================================
   BOUTONS
   ============================================ */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: 1.0625rem;
  font-weight: 600;
  text-decoration: none;
  border-radius: 16px;
  transition: all 300ms cubic-bezier(0.16, 1, 0.3, 1);
  cursor: pointer;
  border: none;
  font-family: inherit;
  letter-spacing: -0.01em;
}

.btn-primary {
  background-color: var(--color-primary);
  color: var(--color-white);
  box-shadow: 
    0 4px 6px -1px rgba(37, 99, 235, 0.2),
    0 2px 4px -1px rgba(37, 99, 235, 0.1);
}

.btn-primary:hover {
  background-color: var(--color-primary-dark);
  transform: translateY(-3px);
  box-shadow: 
    0 10px 15px -3px rgba(37, 99, 235, 0.3),
    0 4px 6px -2px rgba(37, 99, 235, 0.15);
}

.btn-secondary {
  background-color: var(--color-white);
  color: var(--color-gray-900);
  border: 2px solid var(--color-gray-300);
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

.btn-secondary:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
  transform: translateY(-3px);
  box-shadow: 
    0 4px 6px -1px rgba(0, 0, 0, 0.1),
    0 2px 4px -1px rgba(0, 0, 0, 0.06);
}

/* ============================================
   NATIONALITÉS
   ============================================ */

.nationalities-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: var(--spacing-md);
  max-width: 900px;
  margin: 0 auto;
}

@media (min-width: 640px) {
  .nationalities-grid {
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--spacing-lg);
  }
}

.nationality-card {
  background: var(--color-white);
  border: 2px solid var(--color-gray-200);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  text-align: center;
  cursor: pointer;
  transition: all var(--transition-base);
  position: relative;
  overflow: hidden;
}

.nationality-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: var(--color-primary);
  transform: scaleX(0);
  transition: transform var(--transition-base);
}

.nationality-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
  border-color: var(--color-primary-light);
}

.nationality-card:hover::before {
  transform: scaleX(1);
}

.nationality-card.selected {
  border-color: var(--color-primary);
  background-color: rgba(37, 99, 235, 0.05);
}

.nationality-card.selected::before {
  transform: scaleX(1);
}

.nationality-flag {
  font-size: 3rem;
  line-height: 1;
  margin-bottom: var(--spacing-sm);
  display: block;
}

.nationality-name {
  font-weight: 600;
  color: var(--color-gray-900);
  margin-bottom: var(--spacing-xs);
  font-size: 1rem;
}

.nationality-meta {
  font-size: 0.875rem;
  color: var(--color-gray-500);
}

/* ============================================
   INTÉRÊTS / BESOINS
   ============================================ */

.interests-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  justify-content: center;
  max-width: 800px;
  margin: 0 auto;
}

.interest-pill {
  padding: var(--spacing-sm) var(--spacing-lg);
  background-color: var(--color-white);
  border: 2px solid var(--color-gray-300);
  border-radius: 9999px;
  font-size: 0.9375rem;
  font-weight: 500;
  color: var(--color-gray-700);
  cursor: pointer;
  transition: all var(--transition-base);
  font-family: inherit;
}

.interest-pill:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
  transform: translateY(-2px);
}

.interest-pill.selected {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
  color: var(--color-white);
  box-shadow: var(--shadow-md);
}

/* ============================================
   GROUPES WHATSAPP
   ============================================ */

.groups-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-lg);
  margin-top: var(--spacing-xl);
}

@media (min-width: 640px) {
  .groups-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .groups-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.group-card {
  background: var(--color-white);
  border: 1px solid var(--color-gray-200);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  transition: all var(--transition-base);
  display: flex;
  flex-direction: column;
}

.group-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
  border-color: var(--color-primary-light);
}

.group-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm);
}

.group-flag {
  font-size: 2rem;
  line-height: 1;
}

.group-badge {
  font-size: 0.75rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  background-color: var(--color-sand-light);
  color: var(--color-sand-dark);
}

.group-badge.official {
  background-color: rgba(37, 99, 235, 0.1);
  color: var(--color-primary);
}

.group-title {
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--color-gray-900);
  margin-bottom: var(--spacing-xs);
  line-height: 1.4;
}

.group-description {
  font-size: 0.9375rem;
  color: var(--color-gray-600);
  line-height: 1.6;
  margin-bottom: var(--spacing-md);
  flex: 1;
}

.group-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: var(--spacing-sm);
  border-top: 1px solid var(--color-gray-100);
}

.group-members {
  font-size: 0.875rem;
  color: var(--color-gray-500);
  display: flex;
  align-items: center;
  gap: 4px;
}

.group-btn {
  padding: var(--spacing-xs) var(--spacing-md);
  font-size: 0.875rem;
  background-color: var(--color-primary);
  color: var(--color-white);
  border: none;
  border-radius: var(--radius-md);
  cursor: pointer;
  font-weight: 600;
  transition: all var(--transition-fast);
  font-family: inherit;
}

.group-btn:hover {
  background-color: var(--color-primary-dark);
  transform: translateY(-1px);
}

.group-btn-link {
  display: inline-flex;
  text-decoration: none;
}

.groups-empty {
  text-align: center;
  padding: var(--spacing-2xl);
  color: var(--color-gray-600);
}

/* ============================================
   COMMENT ÇA MARCHE
   ============================================ */

.steps-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-xl);
  max-width: 1000px;
  margin: 0 auto;
}

@media (min-width: 768px) {
  .steps-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg);
  }
}

.step-card {
  text-align: center;
  padding: var(--spacing-xl);
  background: var(--color-white);
  border-radius: var(--radius-xl);
  border: 1px solid var(--color-gray-200);
  transition: all var(--transition-base);
}

.step-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
}

.step-number {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  color: var(--color-white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  font-weight: 700;
  margin: 0 auto var(--spacing-md);
  box-shadow: var(--shadow-md);
}

.step-title {
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--color-gray-900);
  margin-bottom: var(--spacing-sm);
}

.step-text {
  font-size: 0.9375rem;
  color: var(--color-gray-600);
  line-height: 1.6;
}

/* ============================================
   À PROPOS
   ============================================ */

.about-content {
  max-width: 1000px;
  margin: 0 auto;
}

.about-text {
  text-align: center;
  margin-bottom: var(--spacing-2xl);
}

.about-description {
  font-size: 1.125rem;
  color: var(--color-gray-700);
  line-height: 1.8;
  max-width: 800px;
  margin: 0 auto;
}

.about-highlights {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-lg);
  margin-top: var(--spacing-2xl);
}

@media (min-width: 768px) {
  .about-highlights {
    grid-template-columns: repeat(3, 1fr);
  }
}

.highlight-card {
  text-align: center;
  padding: var(--spacing-xl);
  background: var(--color-white);
  border-radius: var(--radius-xl);
  border: 1px solid var(--color-gray-200);
  transition: all var(--transition-base);
}

.highlight-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
}

.highlight-icon {
  font-size: 2.5rem;
  margin-bottom: var(--spacing-sm);
}

.highlight-title {
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--color-gray-900);
  margin-bottom: var(--spacing-xs);
}

.highlight-text {
  font-size: 0.9375rem;
  color: var(--color-gray-600);
  line-height: 1.6;
}

/* ============================================
   FAQ
   ============================================ */

.faq-list {
  max-width: 800px;
  margin: 0 auto;
}

.faq-item {
  background: var(--color-white);
  border: 1px solid var(--color-gray-200);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-md);
  overflow: hidden;
  transition: all var(--transition-base);
}

.faq-item:hover {
  box-shadow: var(--shadow-md);
}

.faq-question {
  width: 100%;
  padding: var(--spacing-lg);
  background: none;
  border: none;
  text-align: left;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-gray-900);
  font-family: inherit;
  transition: color var(--transition-fast);
}

.faq-question:hover {
  color: var(--color-primary);
}

.faq-icon {
  font-size: 1.5rem;
  font-weight: 300;
  color: var(--color-primary);
  transition: transform var(--transition-base);
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
}

.faq-item.active .faq-icon {
  transform: rotate(45deg);
}

.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height var(--transition-base), padding var(--transition-base);
  padding: 0 var(--spacing-lg);
}

.faq-item.active .faq-answer {
  max-height: 500px;
  padding: 0 var(--spacing-lg) var(--spacing-lg);
}

.faq-answer p {
  color: var(--color-gray-600);
  line-height: 1.7;
  padding-top: var(--spacing-sm);
}

/* ============================================
   FOOTER
   ============================================ */

.footer {
  background-color: var(--color-gray-900);
  color: var(--color-gray-300);
  padding: var(--spacing-2xl) 0 var(--spacing-lg);
}

.footer-content {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-xl);
  margin-bottom: var(--spacing-xl);
  text-align: center;
}

@media (min-width: 768px) {
  .footer-content {
    grid-template-columns: 1fr 1fr;
    text-align: left;
  }
}

.footer-logo {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--color-white);
  margin-bottom: var(--spacing-sm);
  letter-spacing: -0.02em;
}

.footer-tagline {
  font-size: 0.9375rem;
  color: var(--color-gray-400);
  line-height: 1.6;
}

.footer-links {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  align-items: center;
}

@media (min-width: 768px) {
  .footer-links {
    align-items: flex-end;
  }
}

.footer-link {
  color: var(--color-gray-400);
  text-decoration: none;
  font-size: 0.9375rem;
  transition: color var(--transition-fast);
}

.footer-link:hover {
  color: var(--color-white);
}

.footer-bottom {
  text-align: center;
  padding-top: var(--spacing-lg);
  border-top: 1px solid var(--color-gray-800);
  font-size: 0.875rem;
  color: var(--color-gray-500);
}

/* ============================================
   ANIMATIONS AU SCROLL
   ============================================ */

.fade-in {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity var(--transition-slow), transform var(--transition-slow);
}

.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ============================================
   RESPONSIVE ADJUSTMENTS
   ============================================ */

@media (max-width: 639px) {
  .hero {
    padding: calc(70px + var(--spacing-2xl)) 0 calc(var(--spacing-2xl) + var(--spacing-lg));
    min-height: auto;
  }
  
  .hero-title {
    font-size: 2.2rem;
  }
  
  .hero-subtitle {
    font-size: 1.125rem;
    max-width: 100%;
  }
  
  .hero-cta {
    gap: var(--spacing-sm);
  }
  
  .hero-cta .btn {
    padding: var(--spacing-sm) var(--spacing-lg);
    font-size: 1rem;
  }
  
  .section-title {
    font-size: 1.75rem;
  }
  
  .section {
    padding: var(--spacing-2xl) 0;
  }
  
  .hero-shape-1,
  .hero-shape-2 {
    display: none;
  }
  
  .hero-gradient {
    opacity: 0.5;
  }
}

